# ==============================================================================
# TuneTrack - Environment Configuration Template
# Copy this file to .env or configure in your CI/CD and platform secrets
# ==============================================================================

# Spotify Web API Integration (OAuth 2.0 PKCE)
# Register your app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_REDIRECT_URI_MOBILE=tunetrack://spotify-auth-callback
SPOTIFY_REDIRECT_URI_WEB=http://localhost:8080/spotify-callback.html

# YouTube Data API v3 Integration
# Get your free API key at https://console.cloud.google.com/apis/credentials
# Enable "YouTube Data API v3" in Google Cloud Console
YOUTUBE_API_KEY=your_google_cloud_youtube_data_api_v3_key_here

# Firebase Configuration (Optional - app operates offline-first by default)
FIREBASE_PROJECT_ID=your-tunetrack-firebase-project
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_APP_ID=your-firebase-app-id
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
